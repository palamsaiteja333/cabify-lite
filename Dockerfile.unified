# ==========================================
# Stage 1: Install dependencies
# ==========================================

FROM python:3.12-slim AS builder

WORKDIR /build

COPY rides-api/requirements.txt requirements.txt

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install \
       --no-cache-dir \
       -r requirements.txt


# ==========================================
# Stage 2: Unified application
# ==========================================

FROM python:3.12-slim

WORKDIR /app

RUN useradd --create-home appuser

COPY --from=builder /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app/src" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# One unified application package
COPY src/ ./src/

USER appuser

EXPOSE 8000

CMD ["uvicorn", "cabify_lite.main:app", "--host", "0.0.0.0", "--port", "8000"]
